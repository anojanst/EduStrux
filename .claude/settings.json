      "Bash(git push * +*)",
      "Bash(git *--no-verify*)",
      "Bash(git -c *hooksPath*)",
      "Bash(git config *hooksPath*)",
      "Bash(gh pr merge*)",
      "Bash(gh api *pulls/*/merge*)"
    ]
  }
}
