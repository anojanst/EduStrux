{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Not the deployed name: a bare `wrangler deploy` must never reach the production Worker.
  "name": "edustrux-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Deployed exception stacks point at our source files, in the logs and in Workers Issues.
  "upload_source_maps": true,

  // No static assets here: locally the web app runs on Vite (:5173), which sends /api to this
  // Worker (D-158). The deployed Worker serves the web build, under `env.production`.

  "vars": {
    "ENVIRONMENT": "development",
    "ENABLE_DOCS": "true",
    // Comma-separated origins allowed in the token's azp claim. Empty = not checked (dev only).
    "CLERK_AUTHORIZED_PARTIES": "",
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edustrux",
      // Local only, so the id is a placeholder. The real database is under `env.production`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],

  "r2_buckets": [{ "binding": "FILES", "bucket_name": "edustrux-files" }],

  "queues": {
    "producers": [
      { "binding": "EMAIL_QUEUE", "queue": "edustrux-email" },
      { "binding": "JOBS_QUEUE", "queue": "edustrux-jobs" },
    ],
    "consumers": [
      { "queue": "edustrux-email", "max_batch_size": 10, "max_retries": 5 },
      { "queue": "edustrux-jobs", "max_batch_size": 1, "max_retries": 3 },
    ],
  },

  "triggers": {
    // Hourly: reminders and credit expiry for orgs whose local time matches. Daily: housekeeping.
    "crons": ["0 * * * *", "0 3 * * *"],
  },

  // Everything above is local development and tests. The deployed Worker is `env.production`
  // (`pnpm deploy:production`). Vars and bindings aren't inherited by an environment, so they are
  // repeated here; crons and observability are. Keep the queue settings in step with the ones
  // above and with the retry limit in the code (D-017).
  "env": {
    "production": {
      "name": "edustrux",
      // Logs, and Workers Issues: uncaught exceptions, 5xx responses and `console.error` lines
      // grouped into issues in the dashboard (TUI-83). Here, not at the top level, because the
      // test runner's own wrangler doesn't know `issues` yet.
      "observability": { "enabled": true, "issues": { "enabled": true } },
      // The web app's build (`pnpm deploy:production` builds it first). /api/* always reaches the
      // Worker; any other path is a file from the build, or index.html so the app's own router
      // handles it.
      "assets": {
        "directory": "../web/dist",
        "not_found_handling": "single-page-application",
        // "/" too: the marketing page on edustrux.com, the app on app.edustrux.com (TUI-76).
        "run_worker_first": ["/api/*", "/"],
        "binding": "ASSETS",
      },
      // The app's own address (D-196). Cloudflare makes its DNS record and certificate on deploy;
      // the deploy token needs Zone → Workers Routes: Edit on edustrux.com. The workers.dev
      // address keeps working too.
      "routes": [
        { "pattern": "app.edustrux.com", "custom_domain": true },
        // The marketing page (TUI-76); www is sent to the bare domain.
        { "pattern": "edustrux.com", "custom_domain": true },
        { "pattern": "www.edustrux.com", "custom_domain": true },
      ],
      "vars": {
        "ENVIRONMENT": "production",
        // Off: the app is public at app.edustrux.com, so the docs would be too (D-068). Swagger
        // stays on locally.
        "ENABLE_DOCS": "false",
        // The origins the web app is served from (this Worker). A token minted on any other
        // origin is refused. Add each new origin here when the app gets one.
        "CLERK_AUTHORIZED_PARTIES": "https://app.edustrux.com,https://edustrux.edustrux-api.workers.dev",
        // Links in emails and Stripe's return address (D-196).
        "APP_URL": "https://app.edustrux.com",
        // On mail.edustrux.com, the domain verified with Resend (D-196). Sending also needs the
        // RESEND_API_KEY secret.
        "EMAIL_FROM": "EduStrux <no-reply@mail.edustrux.com>",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "edustrux",
          "database_id": "c2fea74c-1256-4a13-9d77-05f5ac0cc71d",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "edustrux-files" }],
      "queues": {
        "producers": [
          { "binding": "EMAIL_QUEUE", "queue": "edustrux-email" },
          { "binding": "JOBS_QUEUE", "queue": "edustrux-jobs" },
        ],
        "consumers": [
          { "queue": "edustrux-email", "max_batch_size": 10, "max_retries": 5 },
          { "queue": "edustrux-jobs", "max_batch_size": 1, "max_retries": 3 },
        ],
      },
      // Requests a minute per signed-in user and per org, in each Cloudflare location (TUI-81,
      // D-191). Production only: locally and in tests nothing is limited. A namespace id is any
      // number unique in the account; nothing has to be created for it.
      "ratelimits": [
        {
          "name": "USER_RATE_LIMIT",
          "namespace_id": "8101",
          "simple": { "limit": 600, "period": 60 },
        },
        {
          "name": "ORG_RATE_LIMIT",
          "namespace_id": "8102",
          "simple": { "limit": 3000, "period": 60 },
        },
      ],
    },
  },
}
